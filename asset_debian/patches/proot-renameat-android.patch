--- a/src/syscall/enter.c
+++ b/src/syscall/enter.c
@@ -2868,5 +2868,25 @@
 	if (status2 < 0)
 		status = status2;
 
+#if defined(ARCH_X86_64)
+	/* Android's x86_64 application sandbox can reject the legacy
+	 * rename(2) syscall while allowing renameat(2).  Keep the original
+	 * two-argument view through path canonicalization and extensions,
+	 * then publish the same atomic operation through renameat(2).  The
+	 * current-register guard leaves seccomp's existing renameat rewrite
+	 * untouched when that accelerator is enabled. */
+	if (status >= 0
+	    && syscall_number == PR_rename
+	    && get_sysnum(tracee, CURRENT) == PR_rename) {
+		word_t old_path = peek_reg(tracee, CURRENT, SYSARG_1);
+		word_t new_path = peek_reg(tracee, CURRENT, SYSARG_2);
+
+		set_sysnum(tracee, PR_renameat);
+		poke_reg(tracee, SYSARG_4, new_path);
+		poke_reg(tracee, SYSARG_3, AT_FDCWD);
+		poke_reg(tracee, SYSARG_2, old_path);
+		poke_reg(tracee, SYSARG_1, AT_FDCWD);
+	}
+#endif
 	return status;
 }
--- a/src/syscall/exit.c
