+			/* The x86_64 Android compatibility rewrite keeps the guest
+			 * syscall as rename in ORIGINAL but publishes it as
+			 * renameat in MODIFIED. */
+			old_reg = SYSARG_2;
+			new_reg = SYSARG_4;
+		}
+		else if (syscall_number == PR_rename) {
 			old_reg = SYSARG_1;
 			new_reg = SYSARG_2;
 		}
