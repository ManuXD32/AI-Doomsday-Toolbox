<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
      Lint scans dependency bytecode once for the base app and again through each dynamic feature.
      These two archives contain server-side/delegating trust-manager implementations which are
      not the app's HTTP client. Keep TrustAllX509TrustManager enabled for every app-owned source.
    -->
    <issue id="TrustAllX509TrustManager">
        <ignore regexp=".*bcpkix-jdk15to18.*\.jar" />
        <ignore regexp=".*hadoop-client-runtime.*\.jar" />
    </issue>

    <!--
      LAN inference, remote-control, and user-configured local servers intentionally support
      plain HTTP and user-installed CAs. Keep both exceptions pinned to this one declarative
      network configuration; app-owned clients still use normal certificate and hostname checks.
    -->
    <issue id="AcceptsUserCertificates">
        <ignore path="src/main/res/xml/network_security_config.xml" />
    </issue>
    <issue id="InsecureBaseConfiguration">
        <ignore path="src/main/res/xml/network_security_config.xml" />
    </issue>
</lint>
