<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    
    <!-- Network permissions for distributed inference -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x400003"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:version="0"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.vulkan.compute"
        android:version="0"
        android:required="false" />
    
    <application
        android:gwpAsanMode="${gwpAsanMode}"
        android:name=".LlamaApplication"
        android:appComponentFactory=".data.db.RestoreComponentFactory"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LlamaDroid"
        android:usesCleartextTraffic="true"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31"
        tools:replace="android:appComponentFactory">

        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-pixel.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-car.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LlamaDroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            
            <!-- Share intent filters -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <activity
            android:name=".wear.WearServerStartConfirmationActivity"
            android:exported="true"
            android:theme="@style/Theme.LlamaDroid">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="adt"
                    android:host="wear-confirm"
                    android:pathPrefix="/server/start" />
            </intent-filter>
        </activity>

        <activity
            android:name=".service.OrganizerAlarmRingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:theme="@style/Theme.LlamaDroid"
            android:turnScreenOn="true" />

        <activity
            android:name=".tama.shimeji.ShimejiChatActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.example.llamadroid.shimejichat"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LlamaDroid.ShimejiChat" />

        <activity
            android:name=".ui.bubble.ChatBubbleActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.example.llamadroid.chatbubble"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LlamaDroid.ShimejiChat" />

        <service
            android:name=".service.bubble.ChatBubbleOverlayService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_chat_bubble" />
        </service>

        <service
            android:name=".tama.transfer.PetLinkService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="paired_pet_link" />
        </service>

        <service
            android:name=".tama.shimeji.ShimejiOverlayService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="desktop_pet_overlay" />
        </service>

        <service 
            android:name=".service.LlamaService" 
            android:process=":llama_runtime"
            android:foregroundServiceType="specialUse" 
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started local model server hosting on-device LLM inference (llama.cpp) for chats, tools and API clients; runs until the user stops it" />
        </service>

        <service
            android:name=".service.LlamaServerSessionService"
            android:process=":llama_sessions_runtime"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started local LLM server sessions (llama.cpp) hosting on-device inference for chats, tools and API clients; runs until the user stops the server" />
        </service>

        <service
            android:name=".service.DistributedMasterLlamaService"
            android:process=":distributed_llama_runtime"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started distributed LLM server that hosts on-device inference split across the user's own devices; runs until the user stops it" />
        </service>
            
        <service 
            android:name=".service.SDEnvironmentService" 
            android:foregroundServiceType="dataSync|specialUse" 
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started setup of the on-device image-generation environment (model and runtime files); stops when setup finishes" />
        </service>
            
        <service 
            android:name=".service.DownloadService" 
            android:foregroundServiceType="dataSync|specialUse" 
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started download of large on-device AI model files; stops when the downloads finish or the user cancels" />
        </service>
            
        <service
            android:name=".service.StableDiffusionService"
            android:foregroundServiceType="mediaProcessing|dataSync|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device image generation (stable-diffusion.cpp); stops when the job finishes or the user cancels" />
        </service>

        <service
            android:name=".service.OnnxImageGenerationService"
            android:foregroundServiceType="mediaProcessing|dataSync|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device ONNX image generation; stops when the job finishes or the user cancels" />
        </service>

        <service
            android:name=".service.OnnxTtsGenerationService"
            android:foregroundServiceType="mediaProcessing|dataSync|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device text-to-speech generation; stops when the job finishes or the user cancels" />
        </service>

        <service
            android:name=".audio.AudioGenerationService"
            android:foregroundServiceType="mediaProcessing|dataSync|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device music and audio generation; stops when the job finishes or the user cancels" />
        </service>

        <service
            android:name=".audio.music.StableAudio3WorkerService"
            android:process=":stable_audio_worker"
            android:exported="false" />

        <service
            android:name=".service.LlamaCallService"
            android:foregroundServiceType="microphone|mediaPlayback"
            android:exported="false" />

        <service
            android:name=".service.LiveTranslatorService"
            android:foregroundServiceType="microphone|mediaPlayback"
            android:exported="false" />

        <service
            android:name=".service.OnnxBackgroundRemovalService"
            android:foregroundServiceType="mediaProcessing|dataSync|specialUse"
            android:process=":onnx_bgr"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device image background removal; stops when the job finishes or the user cancels" />
        </service>

        <service
            android:name=".service.TamaArtworkGenerationService"
            android:foregroundServiceType="mediaProcessing|dataSync|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device artwork generation for the virtual pet; stops when the job finishes or the user cancels" />
        </service>

        <service
            android:name=".service.TamaDeepDreamService"
            android:foregroundServiceType="dataSync|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device dream image generation for the virtual pet; stops when the job finishes or the user cancels" />
        </service>

        <service
            android:name=".service.VideoGenerationService"
            android:foregroundServiceType="mediaProcessing|dataSync|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device video generation; stops when the job finishes or the user cancels" />
        </service>

        <service
            android:name=".service.GenerationQueueService"
            android:foregroundServiceType="mediaProcessing|dataSync|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started queue of on-device image, audio and video generation jobs; stops when the queue is empty or the user cancels" />
        </service>

        <service
            android:name=".service.OrganizerAlarmRingingService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
            
        <service 
            android:name=".service.WhisperService" 
            android:foregroundServiceType="dataSync|specialUse" 
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device speech transcription (whisper.cpp); stops when the job finishes or the user cancels" />
        </service>
            
        <service 
            android:name=".service.VideoUpscalerService" 
            android:foregroundServiceType="dataSync|specialUse" 
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device video upscaling; stops when the job finishes or the user cancels" />
        </service>

        <service
            android:name=".service.VideoInterpolationService"
            android:foregroundServiceType="dataSync|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device video frame interpolation; stops when the job finishes or the user cancels" />
        </service>
            
        <service 
            android:name=".service.ModelShareService" 
            android:foregroundServiceType="dataSync|specialUse" 
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started sharing of AI model files with the user's own devices on the local network; runs until the user stops it" />
        </service>
            
        <service
            android:name=".service.filestation.FileStationService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started local network file server serving user-selected folders to browsers on the LAN; runs until the user stops it from the notification or app" />
        </service>
            
        <service 
            android:name=".service.ZimShareService" 
            android:foregroundServiceType="dataSync|specialUse" 
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started sharing of offline encyclopedia (ZIM) files on the local network; runs until the user stops it" />
        </service>

        <service
            android:name=".service.AiToolServerService"
            android:foregroundServiceType="dataSync|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started local AI tool server for the user's own clients; runs until the user stops it" />
        </service>
            
        <service 
            android:name=".service.KiwixService" 
            android:foregroundServiceType="dataSync|specialUse" 
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started offline encyclopedia (Kiwix) server on the device; runs until the user stops it" />
        </service>
            
        <service
            android:name=".service.DistributedService" 
            android:foregroundServiceType="dataSync|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started distributed inference worker sharing compute with the user's own devices; runs until the user stops it" />
        </service>

        <service
            android:name=".service.StatsCollectionService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled rootless device telemetry and history" />
        </service>

        <service
            android:name=".service.SdDistributedService"
            android:foregroundServiceType="dataSync|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started distributed image-generation worker for the user's own devices; runs until the user stops it" />
        </service>
            
        <service 
            android:name=".service.SubtitleBurnService" 
            android:foregroundServiceType="dataSync|specialUse" 
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device subtitle burning into a video; stops when the job finishes or the user cancels" />
        </service>
            
        <service 
            android:name=".service.AgentForegroundService" 
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started local AI agent environment with persistent interactive sessions, terminals and project previews; explicitly stopped through visible runtime controls" />
        </service>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
            
        <service 
            android:name=".service.AdventureForegroundService" 
            android:foregroundServiceType="dataSync|specialUse" 
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device LLM story generation for the pet adventure game; stops when the run finishes" />
        </service>

        <service
            android:name=".service.DatasetForegroundService"
            android:foregroundServiceType="dataSync|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device dataset processing with local models; stops when the queue finishes or the user cancels" />
        </service>

        <service
            android:name=".service.MediaTranslationForegroundService"
            android:foregroundServiceType="dataSync|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device audio and video translation; stops when the job finishes or the user cancels" />
        </service>

        <service
            android:name=".service.MangaTranslationForegroundService"
            android:foregroundServiceType="dataSync|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device comic page translation; stops when the job finishes or the user cancels" />
        </service>

        <service
            android:name=".service.KnowledgeBaseIndexingService"
            android:foregroundServiceType="dataSync|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device indexing of the user documents for local search; stops when indexing finishes" />
        </service>

        <service
            android:name=".service.DeepResearchService"
            android:foregroundServiceType="dataSync|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device LLM research task; stops when the report finishes or the user cancels" />
        </service>

        <service 
            android:name=".service.LlamaClientService" 
            android:foregroundServiceType="specialUse" 
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device LLM chat generation and tool calls that must continue while the screen is locked; stops when the response finishes or the user cancels" />
        </service>

        <service
            android:name=".wear.PhoneWearGatewayService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/adt/v1" />
            </intent-filter>
        </service>

        <service
            android:name=".service.LiteRtLmWorkerService"
            android:process=":litert_lm"
            android:exported="false" />
        <service
            android:name=".service.AgentRemoteChatWorkerService"
            android:process=":agent_remote"
            android:stopWithTask="false"
            android:exported="false" />

        <service
            android:name=".service.LlamaScheduledTaskService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-scheduled on-device LLM task that runs a local model at the time the user chose; stops when the task finishes" />
        </service>

        <service
            android:name=".service.QuadtrixTrainingService"
            android:foregroundServiceType="dataSync|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device model training for the Quadtrix game; stops when training finishes or the user cancels" />
        </service>
            
        <!-- Receiver for completed ZIM downloads - must be exported for DOWNLOAD_COMPLETE -->
        <receiver
            android:name=".service.ZimDownloadReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.AiRuntimeBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".tama.notifications.TamaNotificationReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.OrganizerAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.OrganizerAlarmBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.LlamaScheduledTaskReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.GenerationQueueAlarmReceiver"
            android:exported="false" />

        <!-- Each declared worker process acknowledges restore quiescence in its own process. -->
        <receiver android:name=".data.db.LlamaRuntimeRestoreReceiver" android:process=":llama_runtime" android:exported="false" />
        <receiver android:name=".data.db.LlamaSessionsRestoreReceiver" android:process=":llama_sessions_runtime" android:exported="false" />
        <receiver android:name=".data.db.DistributedLlamaRestoreReceiver" android:process=":distributed_llama_runtime" android:exported="false" />
        <receiver android:name=".data.db.StableAudioRestoreReceiver" android:process=":stable_audio_worker" android:exported="false" />
        <receiver android:name=".data.db.OnnxBgrRestoreReceiver" android:process=":onnx_bgr" android:exported="false" />
        <receiver android:name=".data.db.LiteRtRestoreReceiver" android:process=":litert_lm" android:exported="false" />
        <receiver android:name=".data.db.AgentRemoteRestoreReceiver" android:process=":agent_remote" android:exported="false" />

        <receiver
            android:name=".service.AgentSleepWakeReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.delegation.DelegationAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.LlamaScheduledTaskBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.OrganizerCalendarWidgetProvider"
            android:exported="true"
            android:label="@string/widget_calendar_month_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_organizer_calendar" />
        </receiver>

        <receiver
            android:name=".widget.OrganizerUpcomingEventsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_calendar_upcoming_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_organizer_upcoming" />
