    <string name="harness_installations_delete_description">Se eliminará de forma permanente la instalación «%1$s» y todo lo que le pertenece.</string>
    <string name="harness_installations_delete_scope">Solo se selecciona esta instalación. Las demás instalaciones, los datos de la app y los archivos SSH remotos no se modifican.</string>
    <string name="harness_installations_delete_name_label">Escribe el nombre de la instalación</string>
